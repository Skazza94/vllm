# The simulator image plus AISimulate (`timing: aisimulate`): the pinned
# wheel, hash-checked, in vLLM's own environment. Build with
# ../build-docker-aisim.sh; the base image stays usable without it.
ARG BASE=vllm-sim:cpu
FROM ${BASE}
COPY aisimulate-requirements.txt aisimulate-smoke.py /tmp/aisimulate/
RUN /opt/venv/bin/python -m pip install --no-cache-dir --no-deps --require-hashes \
        --extra-index-url https://pypi.nvidia.com \
        -r /tmp/aisimulate/aisimulate-requirements.txt
# Offline, as the servers run.
RUN --network=none HF_HUB_OFFLINE=1 /opt/venv/bin/python /tmp/aisimulate/aisimulate-smoke.py
